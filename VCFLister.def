LIBRARY "VCFLister"
EXPORTS
    ; Detect string (ANSI — TC uses this for both x86 and x64 auto-detect)
    ListGetDetectString
    ListGetDetectStringW

    ; Unicode
    ListLoadW
    ListLoadNextW
    ListCloseWindow
    ListSearchTextW
    ListSendCommand
    ListSetDefaultParams

    ; ANSI (Win32)
    ListLoad
    ListLoadNext
    ListSearchText